unit UImpressora.HP;

interface

uses
  UImpressora.Interfaces, VCL.Dialogs;

Type
  TImpressoraHP = class(TInterfacedObject, IImpressora)
  public
     procedure Imprimir(const Mensagem : String);
  end;

implementation

{ TImpressoraHP }

procedure TImpressoraHP.Imprimir(const Mensagem: String);
begin
  ShowMessage(Mensagem);
end;

end.
